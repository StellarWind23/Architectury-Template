{
  "schemaVersion": 1,
  "id": "${modid}",
  "version": "${mod_version}",
  "name": "${archives_name}",
  "description": ",${description}",
  "authors": [
    "${author}"
  ],
  "contact": {
    "homepage": "${homepage_url}",
    "issues": "${issues_url}"
  },
  "license": "${license}",
  "icon": "assets/${modid}/${modid}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.stellarwind23.template.fabric.TemplateFabric"
    ],
    "client": [
      "com.stellarwind23.template.fabric.client.TemplateFabricClient"
    ]
  },
  "mixins": [
    "template.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*"
  }
}
